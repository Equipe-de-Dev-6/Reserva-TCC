# ============================================================
# Variaveis de ambiente do Reserva SENAI
# ============================================================
# Copie este arquivo para .env e preencha com os dados do seu projeto.
# O .env nao vai para o Git (esta no .gitignore).

# URL do projeto no Supabase
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave SECRETA do projeto (Project Settings -> API -> secret key,
# comeca com "sb_secret_"). Ela fica somente no servidor: e o que a
# API usa para falar com o banco.
SUPABASE_KEY=sua-chave-secreta-do-supabase

# Chave usada para assinar o cookie de sessao. Gere uma:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Precisa ser diferente da SUPABASE_KEY. Se as duas fossem iguais,
# vazar uma abriria o banco e a sessao ao mesmo tempo, e trocar a
# chave do banco derrubaria todas as sessoes abertas.
SECRET_KEY=cole-aqui-uma-chave-aleatoria-longa

# Opcional: origens liberadas no CORS, separadas por virgula.
# Deixe vazio quando o front for servido pela propria API.
CORS_ORIGINS=

# Opcional: marque como 1 quando a aplicacao rodar atrás de HTTPS.
COOKIE_HTTPS=0
